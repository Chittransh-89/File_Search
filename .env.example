# Copy to .env and adjust. Everything stays local.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
# Semicolon or comma separated Windows roots the agent may read.
ALLOWED_ROOTS=E:\
FILE_INDEX_DB=./data/file_index.db
SEARCH_TIMEOUT_SECONDS=25
MAX_CANDIDATES=10
LLM_TIMEOUT_SECONDS=180
# Where the Streamlit UI finds the local FastAPI backend.
API_BASE_URL=http://localhost:8000
